{
  "name": "shirodarts-com",
  "version": "0.0.0",
  "description": "shirodarts.com personal website",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode client && vite build",
    "preview": "wrangler pages dev ./dist",
    "deploy:cf": "pnpm build && wrangler pages deploy ./dist",
    "new-post": "tsx scripts/new-post.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "keywords": [],
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@cloudflare/workers-types": "^4.20260317.1",
    "@hono/vite-build": "^1.10.1",
    "@hono/vite-dev-server": "^0.25.1",
    "@types/node": "^25.5.0",
    "husky": "^9.1.7",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.54.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.5",
  "dependencies": {
    "hono": "^4.12.9",
    "honox": "^0.1.55",
    "marked": "^18.0.0"
  }
}
